# ClientFlow environment variables — PLACEHOLDERS ONLY.
# Copy to .env for local overrides. Never commit real values.
# Production values are set in the hosting provider's settings (see DEPLOYMENT.md).

# ---------------------------------------------------------------- Backend
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Supabase -> Connect -> Session pooler (port 5432), JDBC form
DB_URL=jdbc:postgresql://<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=<db-user>.<project-ref>
DB_PASSWORD=<db-password>
# Small pool: every serverless instance opens its own connections
DB_POOL_SIZE=3
# Optional: separate (admin) account for Flyway migrations, see docs/supabase-least-privilege.sql
FLYWAY_DB_USERNAME=
FLYWAY_DB_PASSWORD=

# Public URL of the frontend: used in email links (never taken from the Host header)
APP_PUBLIC_URL=https://<your-app>.vercel.app
# Comma-separated. Leave empty when the frontend proxies /api (same origin, recommended)
CORS_ALLOWED_ORIGINS=
# Business time zone for deadlines and reports
APP_TIMEZONE=Asia/Almaty

# Email (Gmail SMTP with an app password, see README)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<your-address>@gmail.com
SMTP_PASSWORD=<gmail-app-password>
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=ClientFlow <<your-address>@gmail.com>

# Background job: secret for Vercel Cron (generate a long random string)
CRON_SECRET=<long-random-string>
# Hourly in-process scheduler (useful on always-on hosts; harmless on Vercel)
SCHEDULER_ENABLED=true

# Swagger UI in production (false by default)
OPENAPI_ENABLED=false

# ---------------------------------------------------------------- Local docker-compose
LOCAL_DB_PASSWORD=clientflow

# ---------------------------------------------------------------- Frontend (Vercel)
# Public values only — NEVER put secrets into VITE_ variables (they end up in the JS bundle)
VITE_API_URL=/api/v1
