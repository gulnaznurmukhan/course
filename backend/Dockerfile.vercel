# Vercel builds this file automatically (Dockerfile.vercel).
# ---- Build stage: compile and package the Spring Boot jar ----
FROM eclipse-temurin:21-jdk-alpine AS build
WORKDIR /workspace

# Download dependencies first so they are cached between builds
COPY .mvn/ .mvn/
COPY mvnw pom.xml ./
RUN chmod +x mvnw && ./mvnw -B -q dependency:go-offline

COPY src/ src/
RUN ./mvnw -B -q package -DskipTests \
 && java -Djarmode=tools -jar target/clientflow-backend-*.jar extract --destination extracted \
 && mv extracted/clientflow-backend-*.jar extracted/app.jar

# ---- Runtime stage: only the JRE and the unpacked jar ----
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app

# Unpacked jar + lib/ starts faster than the single fat jar
COPY --from=build /workspace/extracted/ ./

# The start script normalises the environment variables of the Vercel project
# (database URL, credentials, defaults) and then starts the app. See docker-entrypoint.sh.
# Runs as root on purpose: Vercel sends traffic to port 80, which a non-root user may not bind.
COPY docker-entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

# Vercel injects PORT (80 by default) at runtime and it overrides this value
ENV PORT=80 \
    SPRING_PROFILES_ACTIVE=prod
EXPOSE 80

ENTRYPOINT ["/entrypoint.sh"]
